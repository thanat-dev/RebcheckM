{
  "name": "rebcheckm",
  "version": "1.0.0",
  "description": "แอพบันทึกการเดินทางรับเช็คและนำเข้าเช็คธนาคาร พร้อมส่ง LINE",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npx vite build",
    "start": "NODE_ENV=production node server/index.js",
    "db:init": "node server/db/init.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
